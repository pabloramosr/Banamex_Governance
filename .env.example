# API Keys
TAVILY_API_KEY=tvly-...
PINECONE_API_KEY=pcsk_...
INDEX_NAME=banamex-governance
GOOGLE_API_KEY=your_google_api_key_here  # Obligatoria: todos los agentes usan Gemini

# Observabilidad (LangSmith)
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true

# Base de Datos PostgreSQL (Banamex)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=reto_banamex

# Modelos: LLM en Google Gemini; embeddings locales con Ollama
COORDINATOR_MODEL=gemini-3.5-flash
SQL_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=bge-large

